root ::= rule2
rule0 ::= "[" ws (string (ws "," ws string)*)? ws "]"
rule1 ::= "\"a\\\"b\"" | "\"c\\\\d\""
rule2 ::= "{" ws "\"name\"" ws ":" ws string ws "," ws "\"tags\"" ws ":" ws rule0 ws "," ws "\"n\"" ws ":" ws integer ws "," ws "\"x\"" ws ":" ws number ws "," ws "\"ok\"" ws ":" ws boolean ws "," ws "\"kind\"" ws ":" ws rule1 ws "," ws "\"raw\"" ws ":" ws value ws "}"
ws ::= [ \t\n]{0,4}
string ::= "\"" char* "\""
char ::= [^"\\\x7F\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4})
integer ::= "-"? ("0" | [1-9] [0-9]{0,15})
number ::= "-"? ("0" | [1-9] [0-9]{0,15}) ("." [0-9]{1,15})? ([eE] [-+]? [0-9]{1,3})?
boolean ::= "true" | "false"
value ::= jobject | jarray | string | number | "true" | "false" | "null"
jobject ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
jarray ::= "[" ws (value (ws "," ws value)*)? ws "]"
